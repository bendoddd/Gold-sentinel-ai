name: Ufficio XAUUSD

on:
  schedule:
    - cron: "7,37 * * * 0-5"   # ogni 30 minuti, da domenica a venerdì (orari UTC)
  workflow_dispatch: {}          # pulsante "Run workflow" per lanciarlo a mano

permissions:
  contents: write

concurrency:
  group: ufficio
  cancel-in-progress: false

jobs:
  turno:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Turno dell'ufficio
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: python -m ufficio

      - name: Salva report e storico
        run: |
          git config user.name "ufficio-bot"
          git config user.email "ufficio-bot@users.noreply.github.com"
          git add report storico
          git commit -m "turno $(date -u +'%Y-%m-%d %H:%M') UTC" || exit 0
          git pull --rebase
          git push

